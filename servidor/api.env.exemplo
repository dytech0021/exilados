# Configuração do exilados-api. O instalar.sh cria /etc/exilados/api.env (0600, root) a partir deste arquivo na
# primeira instalação, sorteando a chave e os segredos. Nada daqui com valor de verdade entra no repositório.

SUPABASE_URL=https://kobtvgqnitdeviddvymm.supabase.co
# Chave publicável (a mesma do site): o exilados-api sempre fala com o Supabase usando o login da própria pessoa.
SUPABASE_CHAVE=sb_publishable_S0LPicuJdLg-XsrxGiN0Ug_tIDZ4sLo

LIVEKIT_API=http://127.0.0.1:7880
LIVEKIT_CHAVE=<sorteada>
LIVEKIT_SEGREDO=<sorteado>
EXILADOS_URL_VOZ=wss://filabox3d.com.br/exilados

# Senhas de envio e permissões de assistir das lives.
LIVES_SEGREDO=<sorteado>
EXILADOS_RTSPS=rtsps://filabox3d.com.br:8322
MEDIAMTX_API=http://127.0.0.1:9997

# Autorização a quem repassar o que não é ex/... (era o relay do Ponte, até ele deixar de ter lives). Vazio: recusa.
RELAY_AUTH=
